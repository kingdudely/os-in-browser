{
	"name": "os-in-browser",
	"version": "1.0.0",
	"main": "app/index.html",
	"type": "module",
	"chromium-args": "--enable-logging=stderr --disable-gpu --no-sandbox",
	"dependencies": {
		"express": "^5.1.0",
		"express-basic-auth": "^1.2.1",
		"express-ws": "^5.0.2",
		"@octokit/action": "^8.0.4"
	},
	"devDependencies": {
		"node-addon-api": "^8.9.1",
		"nw-builder": "^4.19.0"
	},
	"scripts": {
		"start": "nwbuild --mode=run",
		"build": "nwbuild --mode=build ."
	},
	"nwbuild": {
		"mode": "build",
		"version": "0.115.0",
		"srcDir": ".",
		"outDir": "dist",
		"glob": false,
		"managedManifest": true,
		"nodeAddon": true
	}
}